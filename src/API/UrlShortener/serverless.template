{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Transform": "AWS::Serverless-2016-10-31",
  "Description": "Serverless URL Shortener — ASP.NET Core on AWS Lambda backed by DynamoDB.",
  "Parameters": {
    "TablePrefix": {
      "Type": "String",
      "Default": "",
      "Description": "Optional prefix applied to the DynamoDB table name (e.g. 'dev-', 'prod-')."
    }
  },
  "Globals": {
    "Function": {
      "Runtime": "dotnet8",
      "MemorySize": 512,
      "Timeout": 30,
      "Environment": {
        "Variables": {
          "AmazonOptions__RegionEndpoint": { "Ref": "AWS::Region" },
          "AmazonOptions__TablePrefix": { "Ref": "TablePrefix" },
           "CORS__AllowAnyOrigin": "false",
           "CORS__AllowedOrigins__0": { "Fn::Sub": "http://${FrontendBucket}.s3-website-${AWS::Region}.amazonaws.com" }
        }
      }
    }
  },
  "Resources": {
    "UrlShortenerTable": {
      "Type": "AWS::DynamoDB::Table",
      "Properties": {
        "TableName": { "Fn::Sub": "${TablePrefix}UrlShortener" },
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {
            "AttributeName": "ShortCode",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "ShortCode",
            "KeyType": "HASH"
          }
        ]
      }
    },
    "AspNetCoreFunction": {
      "Type": "AWS::Serverless::Function",
      "Properties": {
        "Handler": "UrlShortener",
       "CodeUri": "./",
        "Policies": [
          {
            "Statement": [
              {
                "Effect": "Allow",
                "Action": [
                  "dynamodb:GetItem",
                  "dynamodb:PutItem",
                  "dynamodb:DeleteItem"
                ],
                "Resource": { "Fn::GetAtt": [ "UrlShortenerTable", "Arn" ] }
              }
            ]
          }
        ],
        "Events": {
          "ProxyResource": {
            "Type": "Api",
            "Properties": {
              "Path": "/{proxy+}",
              "Method": "ANY"
            }
          },
          "RootResource": {
            "Type": "Api",
            "Properties": {
              "Path": "/",
              "Method": "ANY"
            }
          }
        }
      }
    },
        "FrontendBucket": {
          "Type": "AWS::S3::Bucket",
          "Properties": {
            "BucketName": { "Fn::Sub": "${TablePrefix}url-shortener-frontend-${AWS::AccountId}" },
            "WebsiteConfiguration": {
              "IndexDocument": "index.html",
              "ErrorDocument": "index.html"
            },
            "PublicAccessBlockConfiguration": {
              "BlockPublicAcls": false,
              "BlockPublicPolicy": false,
              "IgnorePublicAcls": false,
              "RestrictPublicBuckets": false
            }
          }
        },
        "FrontendBucketPolicy": {
          "Type": "AWS::S3::BucketPolicy",
          "Properties": {
            "Bucket": { "Ref": "FrontendBucket" },
            "PolicyDocument": {
              "Statement": [
                {
                  "Effect": "Allow",
                  "Principal": "*",
                  "Action": "s3:GetObject",
                  "Resource": { "Fn::Sub": "${FrontendBucket.Arn}/*" }
                }
              ]
            }
          }
        }
  },
  "Outputs": {
    "ApiURL": {
      "Description": "API Gateway endpoint URL (Prod stage)",
      "Value": {
        "Fn::Sub": "https://${ServerlessRestApi}.execute-api.${AWS::Region}.amazonaws.com/Prod/"
      }
    },
    "DynamoDBTableName": {
      "Description": "Name of the DynamoDB table storing short URL records",
      "Value": { "Ref": "UrlShortenerTable" }
    },
    "FrontendBucketName": {
            "Description": "Name of the S3 bucket hosting the frontend",
            "Value": { "Ref": "FrontendBucket" }
          },
          "FrontendWebsiteURL": {
            "Description": "S3 static website endpoint URL for the frontend",
            "Value": { "Fn::GetAtt": [ "FrontendBucket", "WebsiteURL" ] }
          }
  }
  
}